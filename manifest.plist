<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS fetches this file, and then the .ipa it points at, by itself. Neither
  request carries a header or a session, which is the whole reason both have to
  sit on a public HTTPS URL rather than behind the build server's auth token.

  bundle-identifier must match the IPA exactly. A mismatch produces an install
  that starts, fills the icon, and fails at the very end with no useful message.
-->
<plist version="1.0">
<dict>
  <key>items</key>
  <array>
    <dict>
      <key>assets</key>
      <array>
        <dict>
          <key>kind</key>
          <string>software-package</string>
          <key>url</key>
          <string>https://pradeep-peddineni-amida.github.io/ta-install-6a9f0e52/MedicaidMember.ipa</string>
        </dict>
      </array>
      <key>metadata</key>
      <dict>
        <key>bundle-identifier</key>
        <string>com.amida.tessarixaccess</string>
        <key>bundle-version</key>
        <string>1.0</string>
        <key>kind</key>
        <string>software</string>
        <key>title</key>
        <string>NC Medicaid</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
